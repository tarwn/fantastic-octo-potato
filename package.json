{
  "name": "computer-use-automation",
  "version": "0.3.0",
  "author": "Eli Weinstock-Herman",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "autofix": "nx run-many --target=autofix",
    "autofix:hub:lint": "nx run hub:lint-fix",
    "autofix:hub:stylelint": "nx run hub:style-lint-fix",
    "autofix:runner-web:lint": "nx run runner-web:lint-fix",
    "autofix:tools:lint": "nx run tools:lint-fix",
    "build:hub": "nx run hub:build",
    "db:migrate:up": "nx run hub:db-migrate-up",
    "db:migrate:down": "nx run hub:db-migrate-down",
    "db:migrate:new": "nx run hub:db-migrate-new",
    "db:reset": "nx run hub:db-reset",
    "dev:hub": "nx run hub:dev",
    "dev:runner-web": "node --watch src/runner-web/index.ts",
    "guard": "nx run-many --target=guard",
    "guard:hub": "nx run hub:guard",
    "guard:hub:check": "nx run hub:check",
    "guard:hub:e2e": "nx run hub:e2e",
    "guard:hub:lint": "nx run hub:lint",
    "guard:hub:stylelint": "nx run hub:style-lint",
    "guard:hub:test": "nx run hub:test",
    "guard:hub:test-integration": "nx run hub:test-integration",
    "guard:runner-web": "nx run runner-web:guard",
    "guard:runner-web:lint": "nx run runner-web:lint",
    "guard:runner-web:test": "nx run runner-web:test",
    "guard:runner-web:tsc": "nx run runner-web:type-check",
    "guard:tools": "nx run tools:guard",
    "guard:tools:lint": "nx run tools:lint",
    "guard:tools:md-links": "nx run tools:md-links",
    "guard:tools:test-file-size": "nx run tools:test-file-size",
    "guard:tools:tsc": "nx run tools:type-check",
    "prepare": "husky && playwright install",
    "preview:hub": "nx run hub:preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.2",
    "dbmate": "2.35.1",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "nx": "23.2.1",
    "postcss-html": "2.0.0",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-scss": "7.2.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
