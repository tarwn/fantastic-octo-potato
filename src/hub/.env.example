HUB_DATABASE_URL=sqlite:.data/hub.db
RUNNER_SHARED_SECRET=change-me

LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me
# Optional: bounded correction-retry count shared by every LLM caller that validates a
# structured response and re-prompts on failure. Defaults to 2 if unset.
LLM_MAX_CORRECTION_ATTEMPTS=2
