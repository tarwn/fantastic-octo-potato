{
	"name": "runner-web",
	"root": "src/runner-web",
	"targets": {
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint src/runner-web",
				"cwd": "{workspaceRoot}"
			}
		},
		"lint-fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint src/runner-web --fix",
				"cwd": "{workspaceRoot}"
			}
		},
		"type-check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p tsconfig.json",
				"cwd": "{workspaceRoot}/src/runner-web"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run",
				"cwd": "{workspaceRoot}/src/runner-web"
			}
		},
		"guard": {
			"executor": "nx:noop",
			"dependsOn": ["lint", "type-check", "test"]
		},
		"autofix": {
			"executor": "nx:noop",
			"dependsOn": ["lint-fix"]
		}
	}
}
