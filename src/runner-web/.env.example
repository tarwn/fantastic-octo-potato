HUB_URL=http://localhost:5173
RUNNER_ID=1
RUNNER_SHARED_SECRET=change-me

# Recipe credential references ({ref:"credential", name:"username"|"password"}) resolve to
# RUNNER_CREDENTIAL_<NAME> env vars (see credentials.ts) — never sent by Hub. Values below match
# the local target-app's seeded login (docs/context/tools/target-app.md).
RUNNER_CREDENTIAL_USERNAME=admin@targetapp.local
RUNNER_CREDENTIAL_PASSWORD=targetapp-seed-pw
