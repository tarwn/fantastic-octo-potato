{
	"name": "tools",
	"root": ".",
	"targets": {
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint . --ignore-pattern \"src/hub/**\" --ignore-pattern \"src/runner-web/**\" --no-error-on-unmatched-pattern",
				"cwd": "{workspaceRoot}"
			}
		},
		"lint-fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "eslint . --ignore-pattern \"src/hub/**\" --ignore-pattern \"src/runner-web/**\" --no-error-on-unmatched-pattern --fix",
				"cwd": "{workspaceRoot}"
			}
		},
		"type-check": {
			"executor": "nx:run-commands",
			"options": {
				"command": "tsc --noEmit -p tsconfig.json",
				"cwd": "{workspaceRoot}"
			}
		},
		"md-links": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node tools/guards/check-md-links.cjs",
				"cwd": "{workspaceRoot}"
			}
		},
		"test-file-size": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node tools/guards/check-test-file-size.cjs",
				"cwd": "{workspaceRoot}"
			}
		},
		"guard": {
			"executor": "nx:noop",
			"dependsOn": ["lint", "type-check", "md-links", "test-file-size"]
		},
		"e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "playwright test",
				"cwd": "{workspaceRoot}/test-e2e"
			}
		},
		"autofix": {
			"executor": "nx:noop",
			"dependsOn": ["lint-fix"]
		}
	}
}
