        "action": "click",
        "args": [
          {
            "by": "css",
            "value": "form input[type='submit']"
          }
        ],
        "intent": "Submit login form"
      },
      {
        "id": "open invoices",
        "action": "click",
        "args": [
          {
            "by": "text",
            "value": "Invoices"
          }
        ],
        "intent": "Open invoice list"
      },
      {
        "id": "check company row",
        "action": "check",
        "args": [
          {
            "test": "exists",
            "args": [
              {
                "by": "text",
                "value": {
                  "ref": "input",
                  "name": "companyName"
                },
                "exact": false
              }
            ]
          }
        ],
        "intent": "Check for company invoice"
      },
      {
        "id": "open company invoice",
        "action": "click",
        "args": [
          {
            "by": "text",
            "value": {
              "ref": "input",
              "name": "companyName"
            },
            "exact": true
          }
        ],
        "intent": "Open company invoice"
      },
      {
        "id": "read invoice id",
        "action": "read",
        "args": [
          {
            "by": "text",
            "value": "Invoice ID",
            "exact": false
          },
          {
            "source": "text",
            "extract": {
              "by": "regex",
              "pattern": "Invoice\\s*ID\\s*:?\\s*(?<value>\\S+)",
              "group": "value"
            },
            "parse": "string"
          },
          {
            "ref": "output",
            "name": "invoice_id"
          }
        ],
        "intent": "Capture invoice ID"
      },
      {
        "id": "inspect invoice",
        "action": "read",
        "args": [
          {
            "by": "css",
            "value": "body"
          },
          "text",
          {
            "ref": "output",
            "name": "invoice_page_text"
          }
        ],
        "intent": "Inspect invoice details"
      },
      {
        "id": "capture invoice id",
        "action": "read",
        "args": [
          {
            "by": "css",
            "value": "body"
          },
          {
            "source": "text",
            "extract": {
              "by": "regex",
              "pattern": "Invoice\\s+(?<value>INV-[A-Za-z0-9-]+)",
              "group": "value"
            },
            "parse": "string"
          },
          {
            "ref": "output",
            "name": "invoice_id"
          }
        ],
        "intent": "Capture invoice ID"
      },
      {
        "id": "capture invoice amount",
        "action": "read",
        "args": [
          {
            "by": "text",
            "value": "Amount:",
            "exact": false
          },
          {
            "source": "text",
            "extract": {
              "by": "regex",
              "pattern": "Amount:\\s*(?<value>\\$\\d+\\.\\d{2})",
              "group": "value"
            },
            "parse": "string"
          },
          {
            "ref": "output",
            "name": "invoice_amount"
          }
        ],
        "intent": "Capture invoice amount"
      },
      {
        "id": "capture invoice total",
        "action": "read",
        "args": [
          {
            "by": "css",
            "value": "body"
          },
          {
            "source": "text",
            "extract": {
              "by": "regex",
              "pattern": "Total:\\s*(?<value>\\$[0-9,]+\\.\\d{2})",
              "group": "value"
            },
            "parse": "string"
          },
          {
            "ref": "output",
            "name": "invoice_total"
          }
        ],
        "intent": "Capture invoice total"
      },
      {
        "id": "finish invoice lookup",
        "action": "finish",
        "args": [
          {
            "test": "all",
            "args": [
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_id"
                  }
                ]
              },
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_amount"
                  }
                ]
              },
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_total"
                  }
                ]
              }
            ]
          }
        ],
        "intent": "Complete invoice lookup"
      }
    ],
