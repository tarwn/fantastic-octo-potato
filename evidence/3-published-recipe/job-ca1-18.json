{
  "id": 18,
  "name": "Get active invoice details",
  "customerApplicationXrefId": 1,
  "jobStatusId": 3,
  "runnerId": 1,
  "createdAt": "2026-09-21T23:00:56.104Z",
  "startedAt": "2026-09-21T23:01:13.850Z",
  "heartbeatOn": "2026-09-21T23:01:21.785Z",
  "completedAt": "2026-09-21T23:01:21.785Z",
  "interventionOwner": null,
  "blockedStepId": null,
  "blockedReason": null,
  "resumeStepId": null,
  "jobType": 2,
  "details": {
    "recipeId": 12,
    "mode": "Execute",
    "allowlist": "http://localhost:8089",
    "stepTimeoutMs": 15000
  },
  "recipe": {
    "schemaVersion": 1,
    "inputs": {
      "companyName": {
        "type": "string",
        "description": "The company name to search for in the invoice list.",
        "required": true,
        "nullable": false,
        "sensitive": false
      },
      "startingUrl": {
        "type": "string",
        "description": "The URL of the Bamboo application.",
        "required": true,
        "nullable": false,
        "sensitive": false
      }
    },
    "outputs": {
      "invoice_amount": {
        "type": "string",
        "description": "The active invoice amount, including its currency symbol, or null if no active invoice exists.",
        "required": true,
        "nullable": true,
        "sensitive": true
      },
      "invoice_id": {
        "type": "string",
        "description": "The active invoice identifier, or null if no active invoice exists.",
        "required": true,
        "nullable": true,
        "sensitive": true
      },
      "invoice_total": {
        "type": "string",
        "description": "The active invoice total, including its currency symbol, or null if no active invoice exists.",
        "required": true,
        "nullable": true,
        "sensitive": true
      }
    },
    "steps": [
      {
        "id": "open_starting_url",
        "action": "open",
        "args": [
          {
            "ref": "input",
            "name": "startingUrl"
          }
        ],
        "intent": "Open Bamboo"
      },
      {
        "id": "enter_login_name",
        "action": "fill",
        "args": [
          {
            "by": "css",
            "value": "input[type='text']:nth-of-type(1)"
          },
          {
            "ref": "credential",
            "name": "username"
          }
        ],
        "intent": "Enter username"
      },
      {
        "id": "enter_password",
        "action": "fill",
        "args": [
          {
            "by": "label",
            "value": "Password"
          },
          {
            "ref": "credential",
            "name": "password"
          }
        ],
        "intent": "Enter password"
      },
      {
        "id": "submit_credentials",
        "action": "click",
        "args": [
          {
            "by": "css",
            "value": "form input[type='submit']"
          }
        ],
        "intent": "Submit login"
      },
      {
        "id": "open_invoices",
        "action": "click",
        "args": [
          {
            "by": "text",
            "value": "Invoices"
          }
        ],
        "intent": "Open invoice list"
      },
      {
        "id": "handle_company_invoice",
        "action": "if",
        "args": [
          [
            {
              "when": {
                "test": "exists",
                "args": [
                  {
                    "by": "text",
                    "value": {
                      "ref": "input",
                      "name": "companyName"
                    },
                    "exact": false
                  }
                ]
              },
              "steps": [
                {
                  "id": "open_company_invoice",
                  "action": "click",
                  "args": [
                    {
                      "by": "text",
                      "value": {
                        "ref": "input",
                        "name": "companyName"
                      },
                      "exact": true
                    }
                  ],
                  "intent": "Open company invoice"
                },
                {
                  "id": "capture_invoice_id",
                  "action": "read",
                  "args": [
                    {
                      "by": "css",
                      "value": "body"
                    },
                    {
                      "source": "text",
                      "extract": {
                        "by": "regex",
                        "pattern": "Invoice\\s+(?<value>INV-[A-Za-z0-9-]+)",
                        "group": "value"
                      },
                      "parse": "string"
                    },
                    {
                      "ref": "output",
                      "name": "invoice_id"
                    }
                  ],
                  "intent": "Capture invoice ID"
                },
                {
                  "id": "capture_invoice_amount",
                  "action": "read",
                  "args": [
                    {
                      "by": "text",
                      "value": "Amount:",
                      "exact": false
                    },
                    {
                      "source": "text",
                      "extract": {
                        "by": "regex",
                        "pattern": "Amount:\\s*(?<value>\\$\\d+\\.\\d{2})",
                        "group": "value"
                      },
                      "parse": "string"
                    },
                    {
                      "ref": "output",
                      "name": "invoice_amount"
                    }
                  ],
                  "intent": "Capture invoice amount"
                },
                {
                  "id": "capture_invoice_total",
                  "action": "read",
                  "args": [
                    {
                      "by": "css",
                      "value": "body"
                    },
                    {
                      "source": "text",
                      "extract": {
                        "by": "regex",
                        "pattern": "Total:\\s*(?<value>\\$[0-9,]+\\.\\d{2})",
                        "group": "value"
                      },
                      "parse": "string"
                    },
                    {
                      "ref": "output",
                      "name": "invoice_total"
                    }
                  ],
                  "intent": "Capture invoice total"
                }
              ]
            }
          ],
          [
            {
              "id": "assign_null_invoice_id",
              "action": "assign",
              "args": [
                {
                  "ref": "output",
                  "name": "invoice_id"
                },
                null
              ],
              "intent": "Set invoice ID null"
            },
            {
              "id": "assign_null_invoice_amount",
              "action": "assign",
              "args": [
                {
                  "ref": "output",
                  "name": "invoice_amount"
                },
                null
              ],
              "intent": "Set invoice amount null"
            },
            {
              "id": "assign_null_invoice_total",
              "action": "assign",
              "args": [
                {
                  "ref": "output",
                  "name": "invoice_total"
                },
                null
              ],
              "intent": "Set invoice total null"
            }
          ]
        ],
        "intent": "Handle invoice result"
      },
      {
        "id": "finish",
        "action": "finish",
        "args": [
          {
            "test": "all",
            "args": [
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_amount"
                  }
                ]
              },
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_id"
                  }
                ]
              },
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_total"
                  }
                ]
              }
            ]
          }
        ],
        "intent": "Finish invoice lookup"
      }
    ],
    "recoveries": []
  },
