  "details": {
    "recipeId": 11,
    "mode": "Trial",
    "allowlist": "http://localhost:8089",
    "stepTimeoutMs": 15000
  },
  "recipe": {
    "schemaVersion": 1,
    "inputs": {
      "companyName": {
        "type": "string",
        "description": "The company name to check for an active invoice.",
        "required": true,
        "nullable": false,
        "sensitive": false
      },
      "startingUrl": {
        "type": "string",
        "description": "The URL of the BambooInvoice application.",
        "required": true,
        "nullable": false,
        "sensitive": false
      }
    },
    "outputs": {
      "invoice_amount": {
        "type": "string",
        "description": "The pre-tax amount of the active invoice, including its currency symbol.",
        "required": true,
        "nullable": true,
        "sensitive": true
      },
      "invoice_id": {
        "type": "string",
        "description": "The identifier of the company's active invoice.",
        "required": true,
        "nullable": true,
        "sensitive": true
      },
      "invoice_total": {
        "type": "string",
        "description": "The total amount of the active invoice, including taxes and its currency symbol.",
        "required": true,
        "nullable": true,
        "sensitive": true
      }
    },
    "steps": [
      {
        "id": "open_start",
        "action": "open",
        "args": [
          {
            "ref": "input",
            "name": "startingUrl"
          }
        ],
        "intent": "Open BambooInvoice"
      },
      {
        "id": "fill_email",
        "action": "fill",
        "args": [
          {
            "by": "label",
            "value": "Email:"
          },
          {
            "ref": "credential",
            "name": "username"
          }
        ],
        "intent": "Enter login email"
      },
      {
        "id": "fill_password",
        "action": "fill",
        "args": [
          {
            "by": "label",
            "value": "Password:"
          },
          {
            "ref": "credential",
            "name": "password"
          }
        ],
        "intent": "Enter login password"
      },
      {
        "id": "submit_login",
        "action": "click",
        "args": [
          {
            "by": "css",
            "value": "input[type=\"submit\"]"
          }
        ],
        "intent": "Log in"
      },
      {
        "id": "open_invoices",
        "action": "click",
        "args": [
          {
            "by": "text",
            "value": "Invoices"
          }
        ],
        "intent": "Open invoice list"
      },
      {
        "id": "filter_client",
        "action": "select",
        "args": [
          {
            "by": "label",
            "value": "Select client"
          },
          [
            {
              "by": "label",
              "value": {
                "ref": "input",
                "name": "companyName"
              }
            }
          ]
        ],
        "intent": "Filter invoices by client"
      },
      {
        "id": "handle_invoice_result",
        "action": "if",
        "args": [
          [
            {
              "when": {
                "test": "exists",
                "args": [
                  {
                    "by": "css",
                    "value": "a[href*=\"invoices/view\"]"
                  }
                ]
              },
              "steps": [
                {
                  "id": "capture_invoice_id",
                  "action": "read",
                  "args": [
                    {
                      "by": "css",
                      "value": "a[href*=\"invoices/view\"]"
                    },
                    {
                      "source": "text",
                      "extract": {
                        "by": "regex",
                        "pattern": "(?<value>INV-\\d+)",
                        "group": "value"
                      },
                      "parse": "string"
                    },
                    {
                      "ref": "output",
                      "name": "invoice_id"
                    }
                  ],
                  "intent": "Capture invoice ID"
                },
                {
                  "id": "open_invoice_detail",
                  "action": "click",
                  "args": [
                    {
                      "by": "css",
                      "value": "a[href*=\"invoices/view\"]"
                    }
                  ],
                  "intent": "Open active invoice"
                },
                {
                  "id": "read_invoice_amount",
                  "action": "read",
                  "args": [
                    {
                      "by": "css",
                      "value": "body"
                    },
                    {
                      "source": "text",
                      "extract": {
                        "by": "regex",
                        "pattern": "Amount:\\s*(?<value>\\$[0-9,.]+)",
                        "group": "value"
                      },
                      "parse": "string"
                    },
                    {
                      "ref": "output",
                      "name": "invoice_amount"
                    }
                  ],
                  "intent": "Capture invoice amount"
                },
                {
                  "id": "read_invoice_total",
                  "action": "read",
                  "args": [
                    {
                      "by": "css",
                      "value": "body"
                    },
                    {
                      "source": "text",
                      "extract": {
                        "by": "regex",
                        "pattern": "Total:\\s*(?<value>\\$[0-9,]+\\.\\d{2})",
                        "group": "value"
                      },
                      "parse": "string"
                    },
                    {
                      "ref": "output",
                      "name": "invoice_total"
                    }
                  ],
                  "intent": "Capture invoice total"
                }
              ]
            }
          ],
          [
            {
              "id": "assign_null_invoice_id",
              "action": "assign",
              "args": [
                {
                  "ref": "output",
                  "name": "invoice_id"
                },
                null
              ],
              "intent": "Clear invoice ID"
            },
            {
              "id": "assign_null_invoice_amount",
              "action": "assign",
              "args": [
                {
                  "ref": "output",
                  "name": "invoice_amount"
                },
                null
              ],
              "intent": "Clear invoice amount"
            },
            {
              "id": "assign_null_invoice_total",
              "action": "assign",
              "args": [
                {
                  "ref": "output",
                  "name": "invoice_total"
                },
                null
              ],
              "intent": "Clear invoice total"
            }
          ]
        ],
        "intent": "Handle active invoice"
      },
      {
        "id": "finish",
        "action": "finish",
        "args": [
          {
            "test": "all",
            "args": [
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_amount"
                  }
                ]
              },
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_id"
                  }
                ]
              },
              {
                "test": "assigned",
                "args": [
                  {
                    "ref": "output",
                    "name": "invoice_total"
                  }
                ]
              }
            ]
          }
        ],
        "intent": "Finish invoice lookup"
      }
    ],
    "recoveries": []
  },
